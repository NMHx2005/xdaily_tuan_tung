# Database
# Runtime (Next.js + adapter-pg): DATABASE_URL
# Prisma CLI (migrate deploy): prisma.config.ts dùng DIRECT_URL, fallback DATABASE_URL
# Supabase production: DATABASE_URL = pooler :6543 + ?pgbouncer=true | DIRECT_URL = session pooler hoặc direct :5432 (xem docs Supabase)
DATABASE_URL="postgresql://xdaily:xdaily_secret@localhost:5433/xdaily?schema=public"
DIRECT_URL="postgresql://xdaily:xdaily_secret@localhost:5433/xdaily?schema=public"
# Adapter `pg` (Next + seed): nếu lỗi TLS «self-signed certificate in certificate chain» (Supabase/proxy), đặt:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage — bucket public: products, blogs, banners (giới hạn 5MB; MIME: jpeg, png, webp)
NEXT_PUBLIC_SUPABASE_URL=""
# Dùng một trong hai: ANON (JWT cũ) hoặc PUBLISHABLE (sb_publishable_... từ Dashboard)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Secret (sb_secret_...) — có thể dùng tên SUPABASE_SECRET_KEY nếu template của bạn đặt vậy
SUPABASE_SERVICE_ROLE_KEY=""

# Payment
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/api/webhooks/vnpay"

# Email (Resend) — đặt ENABLE_ORDER_CONFIRMATION_EMAIL=true và RESEND_API_KEY để gửi mail xác nhận đơn
ENABLE_ORDER_CONFIRMATION_EMAIL=false
RESEND_API_KEY=""
# Địa chỉ gửi (domain phải verify trên Resend), ví dụ: XDAILY <onboarding@resend.dev>
RESEND_FROM=""

# Thông báo form liên hệ — lưu DB luôn bật; gửi email khi ENABLE_CONTACT_NOTIFICATION_EMAIL=true + CONTACT_NOTIFICATION_EMAIL
ENABLE_CONTACT_NOTIFICATION_EMAIL=false
CONTACT_NOTIFICATION_EMAIL=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="XDAILY"
