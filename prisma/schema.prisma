generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────
// ENUMS
// ──────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BannerPlacement {
  HERO
  HOME_FOUR
}

// ──────────────────────────────────
// 1. USER & AUTH
// ──────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  passwordHash String?
  role         UserRole  @default(CUSTOMER)
  image        String?

  orders    Order[]
  reviews   Review[]
  cartItems CartItem[]
  accounts  Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// 2. Account (NextAuth OAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ──────────────────────────────────
// 3. PRODUCT
// ──────────────────────────────────

model Product {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  shortDescription String  @default("")
  description      String  @default("")
  price            Int
  compareAtPrice   Int?
  sku              String  @unique
  inStock          Boolean @default(true)
  stockQuantity    Int     @default(0)
  isFeatured       Boolean @default(false)
  badge            String?
  position         Int     @default(0)
  specifications   Json    @default("[]")

  seoTitle       String @default("")
  seoDescription String @default("")
  /** Thuộc tính biến thể (admin): [{ name, values: string[] }] — dùng để sinh tổ hợp SKU */
  variantOptionGroups Json @default("[]")

  images         ProductImage[]
  variants       ProductVariant[]
  collections    ProductCollection[]
  reviews        Review[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  flashSaleItems FlashSaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([name])
  @@index([isFeatured])
  @@index([badge])
  @@index([createdAt])
}

// 4. ProductImage
model ProductImage {
  id        String @id @default(cuid())
  url       String
  alt       String @default("")
  position  Int    @default(0)
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// 5. ProductVariant
model ProductVariant {
  id             String  @id @default(cuid())
  name           String
  colorHex       String  @default("")
  price          Int
  compareAtPrice Int?
  sku            String  @unique
  inStock        Boolean @default(true)
  image          String?
  position       Int     @default(0)
  productId      String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ──────────────────────────────────
// 6. COLLECTION
// ──────────────────────────────────

model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @default("")
  image       String?
  position    Int     @default(0)
  isVisible   Boolean @default(true)

  /** Tên hiển thị trên menu storefront (nếu trống dùng `name`) */
  navLabel String @default("")
  /** Icon menu: Percent, Armchair, Utensils, Bed, Briefcase, Coffee, Sparkles, Package */
  navIcon  String @default("Package")
  /** Hiện trong sidebar trang chủ / mega menu */
  showInStorefrontNav Boolean @default(false)

  /** Hiện trong dải icon bộ sưu tập (dưới hero) */
  showOnHomeCategoryStrip Boolean @default(false)
  /** Thứ tự trên dải (nhỏ hơn = trái hơn) */
  homeStripPosition       Int    @default(0)
  /** Nhãn trên dải (để trống = tự ghép "Bộ sưu tập …" từ tên) */
  homeStripLabel          String @default("")

  parentId String?
  parent   Collection?  @relation("CollectionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Collection[] @relation("CollectionTree")

  seoTitle       String @default("")
  seoDescription String @default("")

  products ProductCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([parentId])
}

// 7. ProductCollection (join table)
model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

// ──────────────────────────────────
// 8. CART
// ──────────────────────────────────

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int     @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@index([userId])
}

// ──────────────────────────────────
// 9. ORDER
// ──────────────────────────────────

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)

  shippingName     String
  shippingPhone    String
  shippingEmail    String
  shippingAddress  String
  shippingCity     String
  shippingDistrict String
  shippingWard     String
  shippingNote     String?

  subtotal    Int
  shippingFee Int @default(0)
  discount    Int @default(0)
  total       Int

  paymentTransactionId String?

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

// 10. OrderItem
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  name        String
  variantName String?
  price       Int
  quantity    Int
  image       String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ──────────────────────────────────
// 11. REVIEW
// ──────────────────────────────────

model Review {
  id             String @id @default(cuid())
  productId      String
  userId         String?
  author         String
  rating         Int
  content        String
  purchaseStatus String @default("interested")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
}

// ──────────────────────────────────
// 12. BLOG
// ──────────────────────────────────

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  content     String   @default("")
  thumbnail   String?
  author      String   @default("TuAnh")
  tags        String[] @default([])
  isPublished Boolean  @default(false)

  seoTitle       String @default("")
  seoDescription String @default("")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
}

// ──────────────────────────────────
// 13. BANNER
// ──────────────────────────────────

model Banner {
  id          String          @id @default(cuid())
  image       String
  mobileImage String?
  title       String          @default("")
  subtitle    String          @default("")
  link        String          @default("")
  position    Int             @default(0)
  isActive    Boolean         @default(true)
  placement   BannerPlacement @default(HERO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, position])
}

// ──────────────────────────────────
// 14. FLASH SALE
// ──────────────────────────────────

model FlashSale {
  id       String   @id @default(cuid())
  name     String
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  items FlashSaleItem[]

  createdAt DateTime @default(now())
}

// 15. FlashSaleItem
model FlashSaleItem {
  id          String @id @default(cuid())
  flashSaleId String
  productId   String
  salePrice   Int
  position    Int    @default(0)

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
}

// ──────────────────────────────────
// 16. SITE CONTENT (singleton — /admin/website, /admin/about-content)
// ──────────────────────────────────

model SiteContent {
  id        String   @id @default("default")
  payload   Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────
// 16b. ALLOWED IMAGE HOSTS (ảnh ngoài — /admin/image-domains)
// ──────────────────────────────────

model AllowedImageHost {
  id       String @id @default(cuid())
  /** Hostname thường: file.hstatic.net — hoặc *.hstatic.net để khớp mọi subdomain */
  hostname String @unique
  note     String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostname])
}

// ──────────────────────────────────
// 17. NEWSLETTER
// ──────────────────────────────────

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ──────────────────────────────────
// 18. CONTACT MESSAGES (form /contact)
// ──────────────────────────────────

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
}
